{
  "manifest_version": 3,
  "name": "Productivity Suite",
  "version": "1.0.0",
  "description": "A comprehensive browser extension for productivity, session management, and website blocking",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Productivity Suite"
  },
  "options_page": "src/options.html",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Open the extension popup"
    },
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save the current session"
    }
  }
}
